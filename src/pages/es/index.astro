<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const bg = document.getElementById("mode-background");
  const buttons = document.querySelectorAll(".mode");

  const currentTheme = document.documentElement.getAttribute("data-theme") || 
                       (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  buttons.forEach((btn, index) => btn.classList.remove("active"));
  if (currentTheme === "dark") {
    buttons[1].classList.add("active");
    bg.classList.add("is-dark");
  } else {
    buttons[0].classList.add("active");
    bg.classList.remove("is-dark");
  }

  buttons.forEach((btn, index) => {
    btn.addEventListener("click", () => {
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      bg.classList.toggle("is-dark", index === 1);
      document.documentElement.setAttribute("data-theme", index === 1 ? "dark" : "light");
    });
  });
});
</script>

